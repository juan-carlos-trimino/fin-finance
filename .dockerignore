# Before the docker CLI sends the context to the docker daemon, it looks for a file named '.dockerignore' in the root directory
# of the context. If this file exists, the CLI modifies the context to exclude files and directories that match patterns in it.
# This helps to avoid unnecessarily sending large or sensitive files and directories to the daemon and potentially adding them
# to images using ADD or COPY.
#
# Once you add your rules, you can check exactly which files Docker will actually include in the build context without building
# the full image by running:
# docker build --no-cache --progress=plain -f - . <<'EOF' 2>&1 | grep -o '/test/[^ ]*' | sed 's|^/test/||' > /tmp/docker_files.txt
# FROM busybox
# COPY . /test
# RUN find /test -type f
# EOF
#
# grep '^!' .dockerignore | sed 's|^!||; s/\r$//' | while read -r pat; do
#   regex="^$(echo "$pat" | sed 's/\./\\./g; s/\*\*/__DS__/g; s/\*/[^\/]*/g; s/__DS__/.*/g')$"
#   grep -E "$regex" /tmp/docker_files.txt | sort
# done | awk '!seen[$0]++'
#
# (Note: Also added s/\r$// in case your .dockerignore has Windows line endings, which otherwise breaks grep matching.)
#
# This prints a clean list of every file that made it past your .dockerignore rules so you can be 100% sure no files were
# accidentally left out.
#
# Ignore everything
**

# Rules
# !folder (un-ignore): Lets Docker enter the directory.
# folder/* (ignore): Blocks the folder's contents and subfolders, preventing Docker from entering them.
# !folder/** (un-ignore): Includes every file and nested subdirectory inside folder while preserving your exact folder paths.
!src/
src/*
!src/go.mod
!src/go.sum
!src/main.go
#
!src/config
src/config/*
!src/config/config.go
#
!src/databases
src/databases/*
!src/databases/banking
src/databases/banking/*
!src/databases/banking/admin.go
!src/databases/banking/banking.go
!src/databases/banking/init-banking.go
#
!src/finances
src/finances/*
!src/finances/Annuities.go
!src/finances/Bonds.go
!src/finances/Mortgage.go
!src/finances/Periods.go
!src/finances/SimpleInterest.go
#
!src/mathutil
src/mathutil/*
!src/mathutil/mathutil.go
#
!src/renderer
src/renderer/*
!src/renderer/render.go
#
!src/security
src/security/*
!src/security/security.go
#
!src/webfinances
src/webfinances/*
#
!src/webfinances/public
!src/webfinances/public/**
#
!src/webfinances/templates
!src/webfinances/templates/**
#
!src/webfinances/wfadmin
!src/webfinances/wfadmin/**
#
!src/webfinances/wfbanking
!src/webfinances/wfbanking/**
#
!src/webfinances/WfFinAdCpPages.go
!src/webfinances/WfFinAdEppPages.go
!src/webfinances/WfFinAdFvPages.go
!src/webfinances/WfFinAdPvPages.go
